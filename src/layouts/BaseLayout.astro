---
import Seo from '../components/Seo.astro';
import StructuredData from '../components/StructuredData.astro';
import Analytics from '../components/Analytics.astro';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  hreflangOverride?: Partial<Record<Lang, string | null>>;
}

const { lang, title, description, image, noindex, hreflangOverride } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content="egFDzlmGjCJIpFSdQ8LEvauT0uBfXjeTmSJZVmrCNyY" />
    <Seo lang={lang} title={title} description={description} image={image} noindex={noindex} hreflangOverride={hreflangOverride} />
    <!-- Site-wide organization schema (Organization / TravelAgency) on every page -->
    <StructuredData lang={lang} />
    <!-- Consent-gated, privacy-friendly analytics (Plausible) -->
    <Analytics />
    <!-- Page-specific head content (extra JSON-LD, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
