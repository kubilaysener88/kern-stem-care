---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { legalContent } from '../../i18n/legal';

const lang = 'en' as const;
const doc = legalContent[lang].terms;
---

<SiteLayout lang={lang} title={doc.metaTitle} description="The terms that govern use of kernstemcare.com and our medical coordination services — including what we do and what we expressly do not do.">
  <LegalContent lang={lang} doc={doc} />
</SiteLayout>
