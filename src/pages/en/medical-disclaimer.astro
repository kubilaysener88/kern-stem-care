---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { legalContent } from '../../i18n/legal';

const lang = 'en' as const;
const doc = legalContent[lang].medical;
---

<SiteLayout lang={lang} title={doc.metaTitle} description="Kern Stem Care is a medical coordination agency, not a clinic. What that means for the information on this site and for your treatment decisions.">
  <LegalContent lang={lang} doc={doc} />
</SiteLayout>
