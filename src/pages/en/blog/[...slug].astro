---
import { getCollection } from 'astro:content';
import BlogPostPage from '../../../components/pages/BlogPostPage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'en' && !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id.replace(/^en\//, '') }, props: { post } }));
}

const { post } = Astro.props;
---

<BlogPostPage lang="en" post={post} />
