---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { legalContent } from '../../i18n/legal';

const lang = 'en' as const;
const doc = legalContent[lang].privacy;
---

<SiteLayout lang={lang} title={doc.metaTitle} description="How Kern Stem Care collects, uses and protects the personal and health information you share when you request a consultation or a quote.">
  <LegalContent lang={lang} doc={doc} />
</SiteLayout>
