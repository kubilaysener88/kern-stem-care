---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { legalContent } from '../../i18n/legal';

const lang = 'es' as const;
const doc = legalContent[lang].privacy;
---

<SiteLayout lang={lang} title={doc.metaTitle} description="Cómo Kern Stem Care recopila, usa y protege la información personal y de salud que compartes al solicitar una consulta o una cotización.">
  <LegalContent lang={lang} doc={doc} />
</SiteLayout>
