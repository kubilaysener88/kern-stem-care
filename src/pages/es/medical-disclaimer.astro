---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { legalContent } from '../../i18n/legal';

const lang = 'es' as const;
const doc = legalContent[lang].medical;
---

<SiteLayout lang={lang} title={doc.metaTitle} description="Kern Stem Care es una agencia de coordinación médica, no una clínica. Qué significa eso para la información de este sitio y para tus decisiones.">
  <LegalContent lang={lang} doc={doc} />
</SiteLayout>
