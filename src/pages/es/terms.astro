---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LegalContent from '../../components/LegalContent.astro';
import { legalContent } from '../../i18n/legal';

const lang = 'es' as const;
const doc = legalContent[lang].terms;
---

<SiteLayout lang={lang} title={doc.metaTitle} description="Los términos que rigen el uso de kernstemcare.com y de nuestros servicios de coordinación médica — qué hacemos y qué expresamente no hacemos.">
  <LegalContent lang={lang} doc={doc} />
</SiteLayout>
