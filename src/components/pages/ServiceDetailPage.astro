---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import ProseSections from '../ProseSections.astro';
import PathToTreatment from '../PathToTreatment.astro';
import StructuredData from '../StructuredData.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import type { Lang } from '../../i18n/ui';
import { pagesContent } from '../../i18n/pages';

interface Props {
  lang: Lang;
  service: 'stemCells' | 'exosomes' | 'fibroblasts' | 'placenta';
}
const { lang, service } = Astro.props;
const p = pagesContent[lang][service];
// MedicalProcedure schema only for the three cellular therapies (placenta is a
// tissue product, not one of our ProcedureKey entries).
const procedureKeys = ['stemCells', 'exosomes', 'fibroblasts'] as const;
const procedures = procedureKeys.includes(service as (typeof procedureKeys)[number])
  ? [service as (typeof procedureKeys)[number]]
  : [];
const backLabel = lang === 'es' ? '← Todos los servicios' : '← All services';
const ctaLabel = lang === 'es' ? 'Solicitar Consulta Gratis' : 'Request Free Consultation';
const quoteLabel = lang === 'es' ? 'Cotizar mi tratamiento' : 'Get My Treatment Quote';
const servicesLabel = lang === 'es' ? 'Servicios' : 'Services';
---

<SiteLayout lang={lang} title={p.metaTitle} description={p.metaDescription}>
  <StructuredData slot="head" lang={lang} organization={false} procedures={procedures} />
  <Breadcrumbs lang={lang} items={[{ label: servicesLabel, href: `/${lang}/services` }, { label: p.title }]} />
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} image={p.heroImage} />

  <section class="section">
    <div class="wrap">
      <ProseSections sections={p.sections} />
      <div style="display:flex;justify-content:center;margin-top:32px">
        <a href={`/${lang}/contact`} class="btn btn-primary" data-analytics-event="Quote My Treatment">{quoteLabel}</a>
      </div>
    </div>
  </section>

  <PathToTreatment lang={lang} />

  <section class="section">
    <div class="wrap">
      <div class="center" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a href={`/${lang}/services`} class="btn btn-outline">{backLabel}</a>
        <a href={`/${lang}/contact`} class="btn btn-primary">{ctaLabel}</a>
      </div>
    </div>
  </section>
</SiteLayout>
