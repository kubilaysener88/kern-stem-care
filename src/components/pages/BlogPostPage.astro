---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import { render, getCollection, type CollectionEntry } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { withSlash } from '../../i18n/utils';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}
const { lang, post } = Astro.props;
const { Content } = await render(post);

// Find this post's translation (if any) so hreflang can point at its real
// slug instead of guessing the same slug exists in the other language.
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const slugOf = (id: string) => id.replace(/^[a-z]{2}\//, '');
const translation = post.data.translationKey
  ? (await getCollection('blog', (p) => p.data.lang === otherLang && p.data.translationKey === post.data.translationKey && !p.data.draft))[0]
  : undefined;
const hreflangOverride = { [otherLang]: translation ? `/${otherLang}/blog/${slugOf(translation.id)}` : null };

const t =
  lang === 'es'
    ? { crumb: 'Blog', by: 'Por', reviewed: 'Revisado por', updated: 'Actualizado', related: 'Sigue leyendo', all: 'Ver todos los artículos' }
    : { crumb: 'Blog', by: 'By', reviewed: 'Reviewed by', updated: 'Updated', related: 'Keep reading', all: 'See all articles' };

// "Keep reading" — up to three other posts in this language.
//
// Until this existed every post was a dead end: the only internal link into an
// article came from /blog/, and nothing linked back out. Search Console had
// three of the older English posts sitting at "Discovered - currently not
// indexed", which is what a page with a single weak internal link looks like.
// Ranking by shared tags keeps the suggestions relevant, with recency as the
// tie-break so a post never links only to the oldest three.
const siblings = (await getCollection('blog', (p) => p.data.lang === lang && !p.data.draft && p.id !== post.id))
  .map((p) => ({
    post: p,
    shared: p.data.tags.filter((tag) => post.data.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.shared - a.shared || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime())
  .slice(0, 3)
  .map((entry) => entry.post);

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://kernstemcare.com';
const slug = post.id.replace(/^[a-z]{2}\//, '');
const url = `${site}/${lang}/blog/${slug}`;
const fmtDate = (d: Date) => new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: lang,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'Kern Stem Care',
    logo: { '@type': 'ImageObject', url: `${site}/assets/logo/kern-genesis.svg` },
  },
  image: `${site}/og-image.jpg`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};
---

<SiteLayout
  lang={lang}
  title={`${post.data.title} | Kern Stem Care`}
  description={post.data.description}
  hreflangOverride={hreflangOverride}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(articleSchema)} />
  <Breadcrumbs lang={lang} items={[{ label: t.crumb, href: `/${lang}/blog` }, { label: post.data.title }]} />

  <section class="section">
    <div class="wrap">
      <article class="post">
        <p class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
          {post.data.updatedDate && <span> · {t.updated} {fmtDate(post.data.updatedDate)}</span>}
        </p>
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
        <p class="byline">
          {t.by} {post.data.author}
          {post.data.reviewedBy && <span> · {t.reviewed} <span class="ph">{post.data.reviewedBy}</span></span>}
        </p>
        <div class="post-body">
          <Content />
        </div>
      </article>
    </div>
  </section>

  {
    siblings.length > 0 && (
      <section class="section related" aria-labelledby="related-heading">
        <div class="wrap">
          <h2 id="related-heading">{t.related}</h2>
          <div class="grid g3">
            {siblings.map((s) => (
              <a class="card card-link" href={withSlash(`/${lang}/blog/${slugOf(s.id)}`)}>
                <p class="post-date">{fmtDate(s.data.pubDate)}</p>
                <h3 class="post-title">{s.data.title}</h3>
                <p>{s.data.description}</p>
              </a>
            ))}
          </div>
          <p class="related-all">
            <a href={withSlash(`/${lang}/blog`)}>{t.all} →</a>
          </p>
        </div>
      </section>
    )
  }
</SiteLayout>

<style>
  .related {
    background: var(--bg-alt);
  }
  .related h2 {
    font-size: 1.5rem;
    margin: 0 0 22px;
  }
  .related .post-date {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--teal-text);
    margin: 0 0 0.5em;
  }
  .related .post-title {
    font-size: 1.05rem;
    margin: 0 0 0.5em;
  }
  .related-all {
    margin: 26px 0 0;
  }
  .related-all a {
    color: var(--blue);
    font-weight: 700;
    text-decoration: none;
  }
  .related-all a:hover {
    text-decoration: underline;
  }
  .post {
    max-width: 760px;
    margin: 0 auto;
  }
  .post-meta {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--teal-text);
    margin: 0 0 0.5em;
  }
  .post h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
  }
  .byline {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0 0 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  /* Markdown body typography */
  .post-body {
    line-height: 1.75;
    color: #33414f;
  }
  .post-body :global(h2) {
    color: var(--navy);
    font-size: 1.45rem;
    margin: 1.6em 0 0.4em;
  }
  .post-body :global(h3) {
    color: var(--navy);
    font-size: 1.15rem;
    margin: 1.4em 0 0.4em;
  }
  .post-body :global(p),
  .post-body :global(li) {
    color: #33414f;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.3em;
    margin: 0 0 1em;
  }
  .post-body :global(li) {
    margin-bottom: 0.4em;
  }
  .post-body :global(a) {
    color: var(--blue);
    text-decoration: underline;
  }
  /* Markdown pipe-tables render with no default spacing, which reads as the
     columns running into each other. Give them real cell borders/padding.

     Note the table is deliberately NOT a `display: block; overflow-x: auto`
     scroll box: that reads as a scrollable region a keyboard can't reach
     (axe: scrollable-region-focusable) and drops the table's own semantics.
     Instead the cells wrap and tighten on narrow screens so the table simply
     fits — see the media query below. */
  .post-body :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 0 0 1.2em;
    font-size: 0.92rem;
  }
  .post-body :global(th),
  .post-body :global(td) {
    padding: 10px 16px;
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .post-body :global(th) {
    background: var(--bg-alt);
    color: var(--navy);
    font-weight: 700;
  }
  .post-body :global(tr:nth-child(even) td) {
    background: var(--bg-alt);
  }
  /* Phones: tighten the cells so a 3-column comparison table still fits the
     viewport instead of overflowing into a scroll box. */
  @media (max-width: 620px) {
    .post-body :global(table) {
      font-size: 0.82rem;
    }
    .post-body :global(th),
    .post-body :global(td) {
      padding: 8px 9px;
      overflow-wrap: anywhere;
    }
  }
  .post-body :global(blockquote) {
    margin: 0 0 1.2em;
    padding: 14px 20px;
    background: #fff7e6;
    border: 1px solid #f0d98c;
    border-radius: 12px;
    color: #6b5a1e;
    font-size: 0.92rem;
  }
  .post-body :global(.ph) {
    color: var(--blue);
    font-weight: 700;
  }
</style>
