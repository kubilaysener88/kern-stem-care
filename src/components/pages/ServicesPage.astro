---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import StructuredData from '../StructuredData.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import type { Lang } from '../../i18n/ui';
import { pagesContent } from '../../i18n/pages';
import { withSlash } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pagesContent[lang].services;
const more = lang === 'es' ? 'Saber más' : 'Learn more';
const sectionHeading =
  lang === 'es' ? 'Terapias regenerativas que coordinamos' : 'Regenerative therapies we coordinate';
---

<SiteLayout lang={lang} title={p.metaTitle} description={p.metaDescription}>
  <StructuredData slot="head" lang={lang} organization={false} procedures={['stemCells', 'exosomes', 'fibroblasts']} />
  <Breadcrumbs lang={lang} items={[{ label: p.title }]} />
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} image="/assets/hero/laboratorio.webp" />

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <h2 id="services-heading" class="sr-only">{sectionHeading}</h2>
      <div class="grid g4">
        {
          p.cards.map((card) => (
            <a class="card card-link" href={withSlash(`/${lang}/services/${card.slug}`)}>
              {card.image ? (
                <img class="card-img" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
              ) : (
                <div class="ico" aria-hidden="true">{card.icon}</div>
              )}
              <h3>{card.title}</h3>
              <p set:html={card.body} />
              <span class="card-more">{more} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2>{p.compare.title}</h2>
      <p class="lead">{p.compare.lead}</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>{p.compare.head.therapy}</th><th>{p.compare.head.studied}</th><th>{p.compare.head.from}</th></tr>
          </thead>
          <tbody>
            {p.compare.rows.map((r) => (
              <tr><td class="th-name">{r.therapy}</td><td>{r.studied}</td><td class="th-from">{r.from}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="note">{p.compare.note}</p>
      <p class="note">
        <a href={withSlash(`/${lang}/${lang === 'es' ? 'precios' : 'pricing'}`)}>{lang === 'es' ? 'Ver todos los precios →' : 'See every price →'}</a>
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  /* Same approach the prices and blog tables use: cells wrap so the table fits
     rather than becoming a scroll box a keyboard cannot reach. */
  .table-wrap { margin: 18px 0; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; }
  th, td {
    text-align: left;
    padding: 12px 14px;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  th { background: #f1f5f9; color: var(--navy); font-weight: 700; }
  .th-name { font-weight: 600; color: var(--navy); }
  .th-from { font-weight: 700; color: var(--navy); }
  .note { color: #475569; font-size: 0.95rem; margin-top: 14px; }
  .note a { color: #0f5f6b; text-decoration: underline; }
  @media (max-width: 560px) {
    th, td { padding: 9px 8px; font-size: 0.88rem; }
  }
</style>
