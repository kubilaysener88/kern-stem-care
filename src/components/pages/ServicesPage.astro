---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import StructuredData from '../StructuredData.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import type { Lang } from '../../i18n/ui';
import { pagesContent } from '../../i18n/pages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pagesContent[lang].services;
const more = lang === 'es' ? 'Saber más' : 'Learn more';
const sectionHeading =
  lang === 'es' ? 'Terapias regenerativas que coordinamos' : 'Regenerative therapies we coordinate';
---

<SiteLayout lang={lang} title={p.metaTitle} description={p.metaDescription}>
  <StructuredData slot="head" lang={lang} organization={false} procedures={['stemCells', 'exosomes', 'fibroblasts']} />
  <Breadcrumbs lang={lang} items={[{ label: p.title }]} />
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} />

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <h2 id="services-heading" class="sr-only">{sectionHeading}</h2>
      <div class="grid g4">
        {
          p.cards.map((card) => (
            <a class="card card-link" href={`/${lang}/services/${card.slug}`}>
              {card.image ? (
                <img class="card-img" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
              ) : (
                <div class="ico" aria-hidden="true">{card.icon}</div>
              )}
              <h3>{card.title}</h3>
              <p set:html={card.body} />
              <span class="card-more">{more} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>
