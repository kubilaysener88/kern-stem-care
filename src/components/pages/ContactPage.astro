---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import type { Lang } from '../../i18n/ui';
import { pagesContent } from '../../i18n/pages';
import { homeContent } from '../../i18n/home';
import { ANALYTICS_EVENTS } from '../../config/analytics';
import Breadcrumbs from '../Breadcrumbs.astro';
import { navLabels } from '../../i18n/nav';
import { getPhoneCodes, getCountries, phoneCodeLabel } from '../../i18n/phoneCodes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pagesContent[lang].contact;
const c = homeContent[lang].contact;
const successMsg =
  lang === 'es'
    ? '¡Gracias! Recibimos tu solicitud. Un coordinador te contactará en menos de 24 horas.'
    : 'Thank you! We received your request. A coordinator will reach out within 24 hours.';
const errorMsg =
  lang === 'es'
    ? 'No se pudo enviar. Inténtalo de nuevo o escríbenos por WhatsApp.'
    : "Couldn't send. Please try again or message us on WhatsApp.";
const infoHeading = lang === 'es' ? 'Información de contacto' : 'Contact information';
const formHeading = lang === 'es' ? 'Envíanos un mensaje' : 'Send us a message';
---

<SiteLayout lang={lang} title={p.metaTitle} description={p.metaDescription}>
  <Breadcrumbs lang={lang} items={[{ label: navLabels[lang].contact }]} />
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} image="/assets/why/concierge-bilingue.jpg" imagePosition="center 30%" />

  <section class="section">
    <div class="wrap">
      <div class="contact-grid">
        <div aria-labelledby="contact-info-heading">
          <h2 id="contact-info-heading" class="sr-only">{infoHeading}</h2>
          {c.info.map((b) => (
            <div class="info-block"><div class="ico" aria-hidden="true">{b.icon}</div><div><h3>{b.title}</h3><p class="ph">{b.value}</p></div></div>
          ))}
        </div>
        <div class="form-card">
          <h2 id="contact-form-heading" class="sr-only">{formHeading}</h2>
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            data-success={successMsg}
            data-error={errorMsg}
            aria-labelledby="contact-form-heading"
            data-analytics-event={ANALYTICS_EVENTS.contactSubmit}
          >
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="lang" value={lang} />
            <p class="hp-field" aria-hidden="true"><label>{lang === 'es' ? 'No llenar' : 'Do not fill'}<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
            <div class="row">
              <div class="field"><label><span>{c.form.labelFirst}</span><input name="first_name" required /></label></div>
              <div class="field"><label><span>{c.form.labelLast}</span><input name="last_name" required /></label></div>
            </div>
            <div class="row">
              <div class="field"><label><span>{c.form.labelEmail}</span><input name="email" type="email" required /></label></div>
              <div class="field">
                <label for="contact-phone"><span>{c.form.labelPhone}</span></label>
                <div class="phone-group">
                  <select name="phone_country_code" aria-label={phoneCodeLabel[lang]}>
                    {getPhoneCodes(lang).map((p) => (
                      <option value={p.dial} selected={p.iso === 'US'}>
                        {p[lang]} {p.flag} {p.dial}
                      </option>
                    ))}
                  </select>
                  <input id="contact-phone" name="phone" type="tel" autocomplete="tel" />
                </div>
              </div>
            </div>
            <div class="row">
              <div class="field"><label><span>{c.form.labelCountry}</span><select name="country">{getCountries(lang).map((o) => <option value={o.en} selected={o.iso === 'US'}>{o[lang]}</option>)}</select></label></div>
              <div class="field"><label><span>{c.form.labelArea}</span><select name="area">{c.form.areaOptions.map((o) => <option>{o}</option>)}</select></label></div>
            </div>
            <div class="field"><label><span>{c.form.labelMessage}</span><textarea name="message" rows="4"></textarea></label></div>
            <button class="btn btn-primary" style="width:100%">{c.form.submit}</button>
            <p style="font-size:.74rem;color:var(--muted);margin:12px 0 0">{c.form.fineprint}</p>
          </form>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
