---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../PageHero.astro';
import ProseSections from '../ProseSections.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import type { Lang } from '../../i18n/ui';
import { pagesContent } from '../../i18n/pages';
import { navLabels } from '../../i18n/nav';
import { withSlash } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pagesContent[lang].about;
const ctaLabel = lang === 'es' ? 'Hablar con un Coordinador' : 'Talk to a Coordinator';
const mediaPh =
  lang === 'es'
    ? '📷 Reemplazar con foto del equipo / Cancún<br><span class="ph">[equipo-cancun.jpg]</span>'
    : '📷 Replace with photo of your team / Cancún<br><span class="ph">[team-cancun.jpg]</span>';
---

<SiteLayout lang={lang} title={p.metaTitle} description={p.metaDescription}>
  <Breadcrumbs lang={lang} items={[{ label: navLabels[lang].about }]} />
  <PageHero eyebrow={p.eyebrow} title={p.title} lead={p.lead} image="/assets/hero/cancun-aerial.webp" />

  <section class="section">
    <div class="wrap split">
      <div>
        <ProseSections sections={p.sections} />
      </div>
      <div class="media-ph"><span set:html={mediaPh} /></div>
    </div>
    <div class="wrap center" style="margin-top:36px">
      <a href={withSlash(`/${lang}/contact`)} class="btn btn-primary">{ctaLabel}</a>
    </div>
  </section>
</SiteLayout>
