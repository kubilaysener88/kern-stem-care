---
import type { Lang } from '../i18n/ui';
import { navLabels } from '../i18n/nav';
import { homeContent } from '../i18n/home';
import { legalNav } from '../i18n/legal';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = navLabels[lang];
const f = homeContent[lang].footer;
const legal = legalNav(lang);
const legalTitle = lang === 'es' ? 'Legal' : 'Legal';
const info = homeContent[lang].contact.info; // phone, email, office, hours
const base = `/${lang}`;
const year = new Date().getFullYear();

const navTitle = lang === 'es' ? 'Navegación' : 'Explore';
const exploreLinks = [
  { href: base, label: t.home },
  { href: `${base}/about`, label: t.about },
  { href: `${base}/process`, label: t.process },
  { href: `${base}/testimonials`, label: t.testimonials },
  { href: `${base}/blog`, label: lang === 'es' ? 'Blog y Recursos' : 'Blog & Resources' },
  { href: `${base}/contact`, label: t.contact },
];
const serviceLinks = [
  { href: `${base}/services`, label: t.services },
  { href: `${base}/services/stem-cells`, label: t.stemCells },
  { href: `${base}/services/exosomes`, label: t.exosomes },
  { href: `${base}/services/fibroblasts`, label: t.fibroblasts },
  { href: `${base}/services/placenta`, label: t.placenta },
];

// The agency/medical notice that used to sit here now lives in the single site-wide
// disclaimer rendered above the footer (LegalDisclaimer.astro), so it isn't repeated.

// Social links. Facebook and Instagram URLs pending from the client — add them
// here (with the same icon shape) once confirmed; don't guess/invent a handle.
const socialLinks = [
  {
    name: 'TikTok',
    href: 'https://www.tiktok.com/@kernstemcare',
    icon: `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.62h-3.1v13.44c0 1.66-1.34 3-3 3s-3-1.34-3-3 1.34-3 3-3c.3 0 .59.05.86.13V9.6a6.16 6.16 0 0 0-.86-.06c-3.4 0-6.16 2.76-6.16 6.16S6.6 21.86 10 21.86s6.16-2.76 6.16-6.16V9.01a9.03 9.03 0 0 0 5.28 1.7V7.6a5.7 5.7 0 0 1-4.84-1.78Z"/></svg>`,
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@KernStemCare',
    icon: `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.4.6A3 3 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c2 .6 9.4.6 9.4.6s7.4 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12Z"/></svg>`,
  },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div class="brand-col">
        <div class="foot-brand">
          <img class="mark" src="/assets/logo/kern-icon-white.png" alt="" width="34" height="34" /> Kern Stem Care
        </div>
        <p class="blurb">{f.blurb}</p>
        <p class="social-label">{lang === 'es' ? 'Redes Sociales' : 'Social Media'}</p>
        <div class="social-links">
          {socialLinks.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} set:html={s.icon} />
          ))}
        </div>
      </div>

      <nav class="col" aria-label={navTitle}>
        <h2>{navTitle}</h2>
        {exploreLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <nav class="col" aria-label={t.services}>
        <h2>{t.services}</h2>
        {serviceLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <div class="col contact-col">
        <h2>{t.contact}</h2>
        <ul>
          {info.map((b) => (
            <li>
              <span class="ico" aria-hidden="true">{b.icon}</span>
              <span><span class="ico-title">{b.title}</span><span class="ph">{b.value}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <div class="bottom-row">
        <p class="copyright">© {year} Kern Stem Care · {f.legalEntityPh} · {f.rights}</p>
        <nav class="legal-links" aria-label={legalTitle}>
          {
            legal.map((l, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">·</span>}
                <a href={`${base}/${l.slug}`}>{l.label}</a>
              </>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</footer>

<!-- Floating WhatsApp button — replace 1XXXXXXXXXX with the real number (intl format, no +). -->
<a
  id="wa-float"
  href="https://wa.me/529987678979?text=Hi%20Kern%20Stem%20Care%2C%20I%27d%20like%20a%20free%20consultation."
  target="_blank"
  rel="noopener"
  aria-label="Chat on WhatsApp"
>
  <svg viewBox="0 0 32 32" width="30" height="30" fill="#fff" aria-hidden="true">
    <path d="M16 .5C7.4.5.5 7.4.5 16c0 2.8.7 5.4 2 7.7L.5 31.5l8-2.1c2.2 1.2 4.8 1.9 7.5 1.9 8.6 0 15.5-6.9 15.5-15.5S24.6.5 16 .5zm0 28c-2.4 0-4.7-.6-6.7-1.8l-.5-.3-4.7 1.2 1.3-4.6-.3-.5A12.4 12.4 0 0 1 3.5 16C3.5 9.1 9.1 3.5 16 3.5S28.5 9.1 28.5 16 22.9 28.5 16 28.5zm7-9.4c-.4-.2-2.3-1.1-2.6-1.2-.3-.1-.6-.2-.8.2-.2.4-.9 1.2-1.1 1.4-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8.2-.2.4-.4.5-.7.2-.2.2-.4.4-.7.1-.3.1-.5 0-.7-.1-.2-.8-2-1.1-2.7-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.5-.3.4-1.2 1.2-1.2 2.9s1.2 3.4 1.4 3.6c.2.2 2.5 3.8 6 5.3.8.4 1.5.6 2 .8.8.3 1.6.2 2.2.1.7-.1 2.3-.9 2.6-1.8.3-.9.3-1.6.2-1.8-.1-.2-.3-.3-.7-.5z"></path>
  </svg>
  <span class="wa-label">{homeContent[lang].whatsappLabel}</span>
</a>

<style>
  .site-footer {
    background: linear-gradient(180deg, #0d2a4a, #0a2138);
    color: #c6d6e8;
    padding: 60px 0 28px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
    gap: 36px;
  }
  @media (max-width: 860px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }

  .foot-brand {
    color: #fff;
    font-weight: 800;
    font-size: 1.2rem;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .foot-brand .mark {
    width: 34px;
    height: 34px;
    object-fit: contain;
    flex: none;
  }
  .blurb {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #a9c0da;
    max-width: 34ch;
    margin: 0;
  }
  .social-label {
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 18px 0 0;
  }
  .social-links {
    display: flex;
    gap: 10px;
    margin-top: 10px;
  }
  .social-links a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #c6d6e8;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .social-links a:hover {
    background: var(--teal);
    color: #fff;
    transform: translateY(-2px);
  }

  .col h2 {
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .col > a {
    color: #c6d6e8;
    font-size: 0.92rem;
    display: block;
    /* Padding gives each link a >=24px tap target (WCAG 2.5.8 Target Size). */
    padding: 6px 0;
    margin-bottom: 4px;
    transition: color 0.15s;
  }
  .col > a:hover {
    color: #fff;
  }
  /* Visible focus on the dark footer (the global blue ring is low-contrast here). */
  .site-footer a:focus-visible {
    outline: 3px solid #9fd0ff;
    outline-offset: 2px;
    border-radius: 4px;
  }

  .contact-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contact-col li {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    margin-bottom: 14px;
    font-size: 0.9rem;
  }
  .contact-col .ico {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.07);
    display: grid;
    place-items: center;
    font-size: 0.95rem;
  }
  .contact-col .ico-title {
    display: block;
    color: #fff;
    font-weight: 600;
    font-size: 0.82rem;
    margin-bottom: 1px;
  }
  .ph {
    color: #9fd0ff;
    font-weight: 700;
  }

  .foot-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 40px;
    padding-top: 22px;
  }
  .notice {
    font-size: 0.78rem;
    color: #8aa3c0;
    max-width: 70ch;
    margin: 0 0 14px;
  }
  .bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .copyright {
    font-size: 0.8rem;
    color: #8aa3c0;
    margin: 0;
  }
  .copyright .ph {
    color: #9fd0ff;
  }
  .legal-links {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
  }
  .legal-links a {
    color: #c6d6e8;
  }
  .legal-links a:hover {
    color: #fff;
  }
  .legal-links .sep {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Floating WhatsApp */
  #wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 10px;
    /* Accessible green: white text on #25d366 is only 1.98:1 (fails WCAG AA);
       #15803d is 5.0:1. */
    background: #15803d;
    color: #fff;
    padding: 12px 18px 12px 14px;
    border-radius: 50px;
    box-shadow: 0 8px 24px rgba(21, 128, 61, 0.4);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: 0.2s;
  }
  #wa-float:hover {
    transform: translateY(-2px);
    background: #126e34;
    box-shadow: 0 12px 30px rgba(21, 128, 61, 0.5);
  }
  #wa-float .wa-label {
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    #wa-float .wa-label {
      display: none !important;
    }
    #wa-float {
      padding: 14px;
      border-radius: 50%;
    }
  }
</style>
