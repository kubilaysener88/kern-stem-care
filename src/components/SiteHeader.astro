---
import type { Lang } from '../i18n/ui';
import { getNav, getConsultLabel, getTagline } from '../i18n/nav';
import { getRouteFromUrl, withSlash } from '../i18n/utils';
import { ANALYTICS_EVENTS } from '../config/analytics';

interface Props {
  lang: Lang;
  /** Override the language-switcher target when this page's slug differs
      between locales (e.g. blog posts). `null` means no translation exists
      yet, so the switcher falls back to the other language's home page
      instead of a guessed (possibly nonexistent) URL. */
  altLangPath?: string | null;
}
const { lang, altLangPath } = Astro.props;

const nav = getNav(lang);
const consult = getConsultLabel(lang);
const tagline = getTagline(lang);

const current = Astro.url.pathname.replace(/\/+$/, '') || `/${lang}`;
const route = getRouteFromUrl(Astro.url);
const otherLang: Lang = lang === 'en' ? 'es' : 'en';
const otherHref = withSlash(altLangPath !== undefined ? (altLangPath ?? `/${otherLang}`) : `/${otherLang}${route === '/' ? '' : route}`);
const menuLabel = lang === 'es' ? 'Abrir menú' : 'Open menu';

const isActive = (path: string, hasChildren = false) =>
  current === path || (hasChildren && current.startsWith(path + '/'));

const calendarSvg = `<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`;
---

<header class="site-header" id="site-header">
  <div class="wrap bar">
    <a class="brand" href={withSlash(`/${lang}`)} aria-label="Kern Stem Care — home">
      <img class="mark" src="/assets/logo/kern-icon-color.png" alt="" width="40" height="40" />
      <span class="brand-text">
        <span class="brand-name">Kern Stem Care</span>
        <span class="brand-tag">{tagline}</span>
      </span>
    </a>

    <nav class="primary" aria-label={lang === 'es' ? 'Navegación principal' : 'Primary navigation'}>
      <ul class="menu" id="menu">
        {
          nav.map((item) =>
            item.children ? (
              <li class="has-sub">
                <a href={withSlash(item.path)} class:list={['nav-link', { active: isActive(item.path, true) }]} aria-current={isActive(item.path) ? 'page' : undefined}>
                  {item.label} <span class="caret" aria-hidden="true">▾</span>
                </a>
                <ul class="submenu">
                  {item.children.map((child) => (
                    <li>
                      <a href={withSlash(child.path)} class:list={{ active: isActive(child.path) }} aria-current={isActive(child.path) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={withSlash(item.path)} class:list={['nav-link', { active: isActive(item.path) }]} aria-current={isActive(item.path) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
        <li class="menu-cta">
          <a href={withSlash(`/${lang}/contact`)} class="cta-mobile" data-analytics-event={ANALYTICS_EVENTS.bookConsultation}>
            <span class="cta-ico" set:html={calendarSvg} />{consult}
          </a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <div class="lang" role="group" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
        <a href={lang === 'en' ? '#' : otherHref} class:list={{ active: lang === 'en' }} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <a href={lang === 'es' ? '#' : otherHref} class:list={{ active: lang === 'es' }} aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
      </div>
      <a href={withSlash(`/${lang}/contact`)} class="cta" data-analytics-event={ANALYTICS_EVENTS.bookConsultation}>
        <span class="cta-ico" set:html={calendarSvg} />{consult}
      </a>
      <button
        class="hamburger"
        id="hamburger"
        aria-label={menuLabel}
        aria-controls="menu"
        aria-expanded="false"
        onclick="(function(b){var m=document.getElementById('menu');var o=m.classList.toggle('open');b.classList.toggle('is-open',o);b.setAttribute('aria-expanded',o);})(this)"
      >
        <span class="bars"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.25s, background 0.25s;
  }
  .site-header.scrolled {
    box-shadow: 0 6px 24px rgba(13, 42, 74, 0.08);
    background: rgba(255, 255, 255, 0.95);
  }
  /* The header bar may run a touch wider than the 1180 content column so the
     longer Spanish nav + CTA always fit on one row. */
  .bar.wrap {
    max-width: 1380px;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 76px;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    flex: none;
  }
  .brand .mark {
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex: none;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-name {
    font-weight: 800;
    color: var(--navy);
    font-size: 1.12rem;
    letter-spacing: -0.01em;
  }
  .brand-tag {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--teal-text);
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Primary nav */
  .primary {
    display: flex;
    flex: 1;
    justify-content: center;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu > li {
    position: relative;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--ink);
    font-weight: 500;
    font-size: 0.88rem;
    padding: 8px 9px;
    border-radius: 9px;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: var(--blue);
    background: var(--bg-alt);
  }
  .nav-link.active {
    color: var(--blue);
    font-weight: 700;
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--teal);
  }
  .caret {
    font-size: 0.62rem;
    opacity: 0.7;
  }

  /* Dropdown */
  .submenu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 210px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-lg);
    padding: 8px;
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: 0.18s;
  }
  .has-sub::before {
    /* hover bridge so the menu doesn't close in the gap */
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 10px;
  }
  .has-sub:hover .submenu,
  .has-sub:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .submenu a {
    display: block;
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .submenu a:hover,
  .submenu a.active {
    background: var(--bg-alt);
    color: var(--blue);
  }

  /* Actions */
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }
  .lang {
    display: flex;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 50px;
    padding: 3px;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .lang a {
    padding: 5px 11px;
    border-radius: 50px;
    color: var(--muted);
    line-height: 1;
  }
  .lang a.active {
    background: #fff;
    color: var(--navy);
    box-shadow: 0 1px 3px rgba(13, 42, 74, 0.12);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, var(--blue), var(--teal-text));
    color: #fff;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 11px 20px;
    border-radius: 50px;
    box-shadow: 0 8px 20px rgba(21, 101, 192, 0.28);
    transition: transform 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }
  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(21, 101, 192, 0.38);
  }
  .cta-ico {
    display: inline-flex;
  }

  /* CTA inside the mobile menu panel (hidden on desktop) */
  .menu-cta {
    display: none;
  }
  .cta-mobile {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, var(--blue), var(--teal-text));
    color: #fff;
    font-weight: 700;
    padding: 13px 18px;
    border-radius: 50px;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin-right: -8px;
  }
  .bars {
    display: block;
    width: 24px;
    height: 16px;
    position: relative;
  }
  .bars span {
    position: absolute;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--navy);
    border-radius: 2px;
    transition: 0.25s;
  }
  .bars span:nth-child(1) {
    top: 0;
  }
  .bars span:nth-child(2) {
    top: 7px;
  }
  .bars span:nth-child(3) {
    top: 14px;
  }
  .hamburger.is-open .bars span:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }
  .hamburger.is-open .bars span:nth-child(2) {
    opacity: 0;
  }
  .hamburger.is-open .bars span:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }

  /* Tagline only shows on wide screens where there's room next to the full nav. */
  @media (max-width: 1400px) {
    .brand-tag {
      display: none;
    }
  }

  /* Mobile / compact nav (raised so the longer Spanish nav never overflows). */
  @media (max-width: 1240px) {
    .primary {
      position: fixed;
      inset: 76px 0 auto 0;
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
      transform: translateY(-130%);
      transition: transform 0.3s ease, visibility 0.3s ease;
      max-height: calc(100vh - 76px);
      overflow-y: auto;
      pointer-events: none;
      /* Keep collapsed links out of the keyboard tab order (2.4.3 / 2.1.1). */
      visibility: hidden;
    }
    .menu {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 14px 22px 20px;
      width: 100%;
    }
    .menu.open {
      /* the panel is .primary; toggle drives it via :has fallback below */
    }
    /* Drive the panel from the toggled #menu */
    .primary:has(.menu.open) {
      transform: translateY(0);
      pointer-events: auto;
      visibility: visible;
    }
    .nav-link {
      padding: 12px 12px;
      font-size: 1rem;
    }
    .nav-link.active::after {
      display: none;
    }
    .submenu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      padding: 2px 0 6px 14px;
      min-width: 0;
    }
    .caret {
      display: none;
    }
    .hamburger {
      display: block;
    }
    .actions .cta {
      display: none;
    }
    .menu-cta {
      display: block;
      margin-top: 10px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }
  }
</style>

<script is:inline>
  (function () {
    var h = document.getElementById('site-header');
    if (h) {
      // Reading window.scrollY straight out of the scroll event forces the
      // browser to flush layout on every tick (Lighthouse: "forced reflow").
      // Coalesce to one read per frame, and only touch the DOM when the state
      // actually flips — .scrolled only changes shadow/background, so there is
      // nothing to update while the flag stays the same.
      var scrolled = null;
      var ticking = false;
      var apply = function () {
        ticking = false;
        var next = window.scrollY > 8;
        if (next !== scrolled) {
          scrolled = next;
          h.classList.toggle('scrolled', next);
        }
      };
      var onScroll = function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      };
      apply();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    var menu = document.getElementById('menu');
    var burger = document.getElementById('hamburger');
    function closeMenu() {
      if (menu && menu.classList.contains('open')) {
        menu.classList.remove('open');
        if (burger) {
          burger.classList.remove('is-open');
          burger.setAttribute('aria-expanded', 'false');
        }
      }
    }

    var norm = function (p) { return p.replace(/\/+$/, '') || '/'; };

    // A link to the page you're already on shouldn't do a full reload. Just close
    // the menu and jump to the top INSTANTLY (no smooth animation — a smooth scroll
    // on a long page reads as the page "sliding up like a sheet"). Covers header +
    // footer nav. Hash links are left untouched.
    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target.closest ? e.target.closest('a[href]') : null;
      if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
      var url;
      try { url = new URL(a.href, location.href); } catch (_) { return; }
      if (url.origin !== location.origin || url.hash) return;
      if (norm(url.pathname) === norm(location.pathname)) {
        e.preventDefault();
        closeMenu();
        // Instant jump to the top — no smooth animation (a smooth scroll on a long
        // page reads as the page "sliding up like a sheet"). Use the scroll element
        // directly so it works even with `overflow-x: clip` on <html>.
        var se = document.scrollingElement || document.documentElement || document.body;
        se.scrollTop = 0;
      } else {
        closeMenu();
      }
    });
  })();
</script>
