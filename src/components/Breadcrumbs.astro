---
import type { Lang } from '../i18n/ui';

/**
 * Visible breadcrumb trail + BreadcrumbList JSON-LD (SEO).
 * Pass the trail AFTER home (home is prepended automatically); the last item is
 * the current page and is not linked.
 */
export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  lang: Lang;
  items: Crumb[];
}
const { lang, items } = Astro.props;

const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://www.kernstemcare.com';
const homeLabel = lang === 'es' ? 'Inicio' : 'Home';
const trail: Crumb[] = [{ label: homeLabel, href: `/${lang}` }, ...items];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: `${site}${c.href}` } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}>
  <ol class="wrap">
    {
      trail.map((c, i) => {
        const isLast = i === trail.length - 1;
        return (
          <li>
            {c.href && !isLast ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            {!isLast && <span class="sep" aria-hidden="true">›</span>}
          </li>
        );
      })
    }
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonld)} />

<style>
  .breadcrumbs {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--line);
    font-size: 0.82rem;
  }
  .breadcrumbs ol {
    list-style: none;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 0;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
  }
  .breadcrumbs a {
    color: var(--muted);
  }
  .breadcrumbs a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
  .breadcrumbs [aria-current='page'] {
    color: var(--navy);
    font-weight: 600;
  }
  .breadcrumbs .sep {
    color: var(--muted);
    margin: 0 9px;
  }
</style>
