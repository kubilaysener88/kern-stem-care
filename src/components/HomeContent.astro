---
import type { Lang } from '../i18n/ui';
import { homeContent } from '../i18n/home';
import { ANALYTICS_EVENTS } from '../config/analytics';
import { getPhoneCodes, getCountries, phoneCodeLabel } from '../i18n/phoneCodes';
import LegalDisclaimer from './LegalDisclaimer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = homeContent[lang];

const accentStyle: Record<string, string> = {
  blue: 'border-top:4px solid var(--blue)',
  teal: 'border-top:4px solid var(--teal)',
  gold: 'border-top:4px solid var(--gold)',
  green: 'border-top:4px solid #16a34a',
  'teal-border': 'border:1px solid var(--teal)',
};

const successMsg =
  lang === 'es'
    ? '¡Gracias! Recibimos tu solicitud. Un coordinador te contactará en menos de 24 horas.'
    : 'Thank you! We received your request. A coordinator will reach out within 24 hours.';
const errorMsg =
  lang === 'es'
    ? 'No se pudo enviar. Inténtalo de nuevo o escríbenos por WhatsApp.'
    : "Couldn't send. Please try again or message us on WhatsApp.";
---

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="wrap">
    <div>
      <span class="hero-flags">🇲🇽 <span>{c.hero.flagsPre}</span> · <span>{c.hero.flagsMid}</span> 🌎 🇺🇸 🇨🇦</span>
      <h1>{c.hero.h1}</h1>
      {c.hero.tagline && <p class="hero-tagline">{c.hero.tagline}</p>}
      {c.hero.p && <p>{c.hero.p}</p>}
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px">
        {c.hero.pills.map((pill) => (
          <a class="hero-flags pill-link" style="margin:0" href={`/${lang}/services/${pill.slug}`}>{pill.label}</a>
        ))}
      </div>
      <div class="hero-cta">
        <a href={`/${lang}/contact`} class="btn btn-primary">{c.hero.ctaPrimary}</a>
        <a href={`/${lang}/services`} class="btn btn-ghost">{c.hero.ctaGhost}</a>
      </div>
    </div>
    <div class="hero-card">
      <h2>{c.hero.card.title}</h2>
      <p style="font-size:.85rem;color:var(--muted);margin-bottom:14px">{c.hero.card.subtitle}</p>
      <form name="lead" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-success={successMsg} data-error={errorMsg} data-analytics-event={ANALYTICS_EVENTS.bookConsultation}>
        <input type="hidden" name="form-name" value="lead" />
        <input type="hidden" name="lang" value={lang} />
        <p class="hp-field" aria-hidden="true"><label>{lang === 'es' ? 'No llenar' : 'Do not fill'}<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="field"><label><span>{c.hero.card.labelName}</span><input name="full_name" required placeholder={c.hero.card.phName} /></label></div>
        <div class="field"><label><span>{c.hero.card.labelEmail}</span><input name="email" type="email" required placeholder={c.hero.card.phEmail} /></label></div>
        <div class="field"><label><span>{c.hero.card.labelCountry}</span>
          <select name="country">{getCountries(lang).map((o) => <option value={o.en} selected={o.iso === 'US'}>{o[lang]}</option>)}</select></label></div>
        <div class="field"><label><span>{c.hero.card.labelCondition}</span><input name="condition" placeholder={c.hero.card.phCondition} /></label></div>
        <button class="btn btn-primary">{c.hero.card.submit}</button>
        <p class="tiny">{c.hero.card.fineprint}</p>
      </form>
    </div>
  </div>
</section>

<!-- ============ ROLE DISCLOSURE BANNER ============ -->

<!-- ============ CORE THERAPIES ============ -->
<section class="section" id="therapies">
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">{c.therapies.eyebrow}</span>
      <h2>{c.therapies.h2}</h2>
      <p class="lead">{c.therapies.lead}</p>
    </div>
    <div class="grid g4" style="margin-top:44px">
      {c.therapies.cards.map((card) =>
        card.slug ? (
          <a class="card card-link" href={`/${lang}/services/${card.slug}`} style={card.accent ? accentStyle[card.accent] : undefined}>
            {card.image ? (
              <img class="card-img" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="ico">{card.icon}</div>
            )}
            <h3>{card.title}</h3>
            <p set:html={card.body} />
            <span class="card-more">{lang === 'es' ? 'Saber más' : 'Learn more'} →</span>
          </a>
        ) : (
          <div class="card" style={card.accent ? accentStyle[card.accent] : undefined}>
            {card.image ? (
              <img class="card-img" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="ico">{card.icon}</div>
            )}
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </div>
        )
      )}
    </div>
  </div>
</section>

<!-- ============ TRUST BAR ============ -->
<section class="trust" aria-label={lang === 'es' ? 'Datos clave' : 'Key facts'}>
  <div class="wrap">
    {c.trust.map((s) => (
      <div><div class={s.isPh ? 'num ph' : 'num'}>{s.num}</div><div class="lbl">{s.label}</div></div>
    ))}
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section alt" id="testimonials">
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">{c.testimonials.eyebrow}</span>
      <h2>{c.testimonials.h2}</h2>
      <p class="lead" set:html={c.testimonials.lead} />
    </div>
    <div class="vgrid" id="vgrid">
      {c.testimonials.cards.map((card) => (
        <div class="vcard" data-seg={card.seg}>
          <div class="vthumb"><div class="tag">{card.tag}</div><div class="play">▶</div><div class="drop">{card.drop}</div></div>
          <div class="vbody"><h3 class="ph">{card.name}</h3><div class="meta ph">{card.meta}</div><p class="ph">{card.summary}</p></div>
        </div>
      ))}
    </div>
    <div class="center" style="margin-top:24px">
      <a href={`/${lang}/testimonials`} class="btn btn-outline">{c.testimonials.eyebrow}</a>
    </div>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="section" id="about">
  <div class="wrap split">
    <div>
      <span class="eyebrow">{c.about.eyebrow}</span>
      <h2>{c.about.h2}</h2>
      <p>{c.about.p}</p>
      <ul class="check">
        {c.about.checks.map((li) => <li>{li}</li>)}
      </ul>
      <a href={`/${lang}/about`} class="btn btn-outline">{c.about.cta}</a>
    </div>
    <div class="media-ph"><span set:html={c.about.mediaPh} /></div>
  </div>
</section>

<!-- ============ WHY ============ -->
<section class="section alt">
  <div class="wrap center">
    <span class="eyebrow">{c.why.eyebrow}</span>
    <h2>{c.why.h2}</h2>
    <p class="lead">{c.why.lead}</p>
    <div class="grid g4" style="margin-top:40px;text-align:left">
      {c.why.cards.map((card) => (
        <div class="card">
          {card.image ? (
            <img class="card-img" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
          ) : (
            <div class="ico">{card.icon}</div>
          )}
          <h3>{card.title}</h3>
          <p>{card.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ TREATMENTS ============ -->
<section class="section" id="treatments">
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">{c.treatments.eyebrow}</span>
      <h2>{c.treatments.h2}</h2>
      <p class="lead">{c.treatments.lead}</p>
    </div>
    <div class="grid g3" style="margin-top:42px">
      {c.treatments.cards.map((card) =>
        card.slug ? (
          <a class="card card-link" href={`/${lang}/services/${card.slug}`} style={card.accent ? accentStyle[card.accent] : undefined}>
            {card.image ? (
              <img class="card-img" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="ico">{card.icon}</div>
            )}
            <h3>{card.title}</h3>
            <p set:html={card.body} />
            <span class="card-more">{lang === 'es' ? 'Saber más' : 'Learn more'} →</span>
          </a>
        ) : (
          <div class="card" style={card.accent ? accentStyle[card.accent] : undefined}>
            {card.image ? (
              <img class="card-img" src={card.image} alt={card.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="ico">{card.icon}</div>
            )}
            <h3>{card.title}</h3>
            <p set:html={card.body} />
          </div>
        )
      )}
    </div>
  </div>
</section>

<!-- ============ PATIENT JOURNEY ============ -->
<section class="section alt jsection" id="journey">
  <div class="jblob jblob-1" aria-hidden="true"></div>
  <div class="jblob jblob-2" aria-hidden="true"></div>
  <div class="jblob jblob-3" aria-hidden="true"></div>
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">{c.journey.eyebrow}</span>
      <h2>{c.journey.h2}</h2>
    </div>
    <div class="jtimeline">
      {c.journey.steps.map((step, i) => (
        <div class="jstep">
          <div class="jbadge">{i + 1}</div>
          <div
            class:list={['jglass', { 'has-photo': !!step.image }]}
            style={step.image ? `background-image: linear-gradient(135deg, rgba(255,255,255,0.74) 0%, rgba(255,255,255,0.48) 100%), url(${step.image})` : undefined}
          >
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ TEAM ============ -->
<section class="section" id="team">
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">{c.team.eyebrow}</span>
      <h2>{c.team.h2}</h2>
      <p class="lead">{c.team.lead}</p>
    </div>

    <h3 style="text-align:center;margin:36px 0 18px;color:var(--teal-text)">{c.team.coordinatorsTitle}</h3>
    <div class="grid g3">
      {c.team.coordinators.map((p) => (
        <div class="doc"><div class="photo">{p.photoPh}</div><div class="body"><h3 class="ph">{p.name}</h3><div class="role ph">{p.role}</div><p class="ph">{p.bio}</p></div></div>
      ))}
    </div>

    <h3 style="text-align:center;margin:48px 0 8px;color:var(--teal-text)">{c.team.partnersTitle}</h3>
    <p class="lead center" style="margin-bottom:24px">{c.team.partnersLead}</p>
    <div class="grid g4">
      {c.team.partners.map((p) => (
        <a class="card card-link center" href={`/${lang}/partners/${p.slug}`}>
          {p.image ? (
            <img class="card-img" src={p.image} alt={p.name} loading="lazy" decoding="async" />
          ) : (
            <div class="ico" style="margin:0 auto 14px">{p.icon}</div>
          )}
          <h3 class="ph">{p.name}</h3>
          <p class="ph">{p.detail}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ============ MEDIA CAROUSEL ============ -->
<section class="section alt" id="showcase" style="padding-top:48px;padding-bottom:48px">
  <div class="wrap">
    <div class="center" style="margin-bottom:26px">
      <span class="eyebrow">{c.showcase.eyebrow}</span>
      <h2>{c.showcase.h2}</h2>
    </div>
    <div class="kc" id="kc">
      <div class="kc-track" id="kc-track">
        {c.showcase.slides.map((s) => (
          <div class="kc-slide">
            {s.video ? (
              <video src={s.video} poster={s.poster} controls preload="none" playsinline aria-label={s.caption} />
            ) : s.image ? (
              <img src={s.image} alt={s.caption} loading="lazy" decoding="async" />
            ) : (
              <div class="kc-ph">{s.emoji} <span class="ph">{s.ph}</span></div>
            )}
            <div class="kc-cap"><span>{s.caption}</span></div>
          </div>
        ))}
      </div>
      <button class="kc-arrow kc-prev" id="kc-prev" aria-label="Previous">‹</button>
      <button class="kc-arrow kc-next" id="kc-next" aria-label="Next">›</button>
      <div class="kc-dots" id="kc-dots"></div>
    </div>
    <div class="center" style="margin-top:26px">
      <a href={`/${lang}/contact`} class="btn btn-primary" style="font-size:1.05rem;padding:16px 34px">{c.showcase.ctaBook}</a>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section" id="faq">
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">{c.faq.eyebrow}</span>
      <h2>{c.faq.h2}</h2>
    </div>
    <div class="faq" style="margin-top:38px">
      {c.faq.items.map((item) => (
        <div class="qa">
          <button onclick="this.parentElement.classList.toggle('open')"><span>{item.q}</span><span class="pm">+</span></button>
          <div class="ans"><p set:html={item.a} /></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MEMBERSHIP section removed per request (pricing tiers + newsletter). Content
     kept in home.ts (membership) so it can be restored if needed. -->

<!-- ============ CONTACT ============ -->
<section class="section alt" id="contact">
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">{c.contact.eyebrow}</span>
      <h2>{c.contact.h2}</h2>
    </div>
    <div class="contact-grid" style="margin-top:42px">
      <div>
        {c.contact.info.map((b) => (
          <div class="info-block"><div class="ico" aria-hidden="true">{b.icon}</div><div><h3>{b.title}</h3><p class="ph">{b.value}</p></div></div>
        ))}
      </div>
      <div class="form-card">
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-success={successMsg} data-error={errorMsg} data-analytics-event={ANALYTICS_EVENTS.contactSubmit}>
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="lang" value={lang} />
          <p class="hp-field" aria-hidden="true"><label>{lang === 'es' ? 'No llenar' : 'Do not fill'}<input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="row">
            <div class="field"><label><span>{c.contact.form.labelFirst}</span><input name="first_name" required /></label></div>
            <div class="field"><label><span>{c.contact.form.labelLast}</span><input name="last_name" required /></label></div>
          </div>
          <div class="row">
            <div class="field"><label><span>{c.contact.form.labelEmail}</span><input name="email" type="email" required /></label></div>
            <div class="field">
              <label for="home-phone"><span>{c.contact.form.labelPhone}</span></label>
              <div class="phone-group">
                <select name="phone_country_code" aria-label={phoneCodeLabel[lang]}>
                  {getPhoneCodes(lang).map((p) => (
                    <option value={p.dial} selected={p.iso === 'US'}>
                      {p[lang]} {p.flag} {p.dial}
                    </option>
                  ))}
                </select>
                <input id="home-phone" name="phone" type="tel" autocomplete="tel" />
              </div>
            </div>
          </div>
          <div class="row">
            <div class="field"><label><span>{c.contact.form.labelCountry}</span><select name="country">{getCountries(lang).map((o) => <option value={o.en} selected={o.iso === 'US'}>{o[lang]}</option>)}</select></label></div>
            <div class="field"><label><span>{c.contact.form.labelArea}</span><select name="area">{c.contact.form.areaOptions.map((o) => <option>{o}</option>)}</select></label></div>
          </div>
          <div class="field"><label><span>{c.contact.form.labelMessage}</span><textarea name="message" rows="4"></textarea></label></div>
          <button class="btn btn-primary" style="width:100%">{c.contact.form.submit}</button>
          <p style="font-size:.74rem;color:var(--muted);margin:12px 0 0">{c.contact.form.fineprint}</p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- The site's only legal/medical disclaimer — home page, page foot, once. -->
<LegalDisclaimer lang={lang} />

<style>
  /* HERO */
  .hero {
    position: relative;
    color: #fff;
    background: url('/assets/hero/cancun-aerial.jpg') center 60% / cover no-repeat;
    overflow: hidden;
  }
  /* Brand-color gradient over the photo, dark enough on the left (where the
     text sits) for AA contrast, easing off toward the right so the photo
     still reads through. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgba(9, 27, 48, 0.94) 0%, rgba(13, 42, 74, 0.88) 32%, rgba(19, 66, 122, 0.68) 60%, rgba(10, 110, 116, 0.55) 100%);
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="60" height="60"><circle cx="30" cy="30" r="1.4" fill="white" opacity="0.18"/></svg>');
    opacity: 0.5;
  }
  .hero .wrap {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    margin-bottom: 0.4em;
    text-shadow: 0 2px 4px rgba(2, 8, 16, 0.7), 0 0 24px rgba(2, 8, 16, 0.5);
  }
  .hero > .wrap > div:first-child > p {
    color: #dce9f6;
    font-size: 1.15rem;
    max-width: 560px;
    text-shadow:
      0 0 3px rgba(2, 8, 16, 0.9),
      0 0 3px rgba(2, 8, 16, 0.9),
      0 0 8px rgba(2, 8, 16, 0.85),
      0 0 8px rgba(2, 8, 16, 0.85),
      0 2px 5px rgba(2, 8, 16, 0.7);
  }
  .hero-tagline {
    font-weight: 600;
    color: #eaf3fc !important;
    font-size: 1.05rem !important;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 3px rgba(2, 8, 16, 0.7), 0 0 16px rgba(2, 8, 16, 0.5);
  }
  /* Hero chips are links to each service page. */
  .pill-link {
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }
  .pill-link:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  /* Single consolidated disclaimer at the foot of the page — tighter than a normal
     section so it reads as a legal footnote, not as content. */
  .home-legal {
    padding-top: 8px;
    padding-bottom: 40px;
  }
  /* .card-link lives in global.css — shared with the Services index. */
  .hero-flags {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 22px;
  }
  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 26px;
  }
  /* High-contrast focus ring against the dark hero. */
  .hero .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .hero-card {
    /* Frosted-glass card: translucent enough to let the hero photo bleed
       through, but the blur behind it removes the photo's fine detail so
       text on top stays fully legible instead of fighting a busy image. */
    background: rgba(255, 255, 255, 0.68);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    color: var(--ink);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius);
    padding: 26px;
    box-shadow: var(--shadow-lg);
  }
  .hero-card h2 {
    color: var(--navy);
    font-size: 1.25rem;
  }
  .hero-card .field {
    margin-bottom: 12px;
  }
  .hero-card label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--muted);
    display: block;
  }
  .hero-card label > span {
    display: block;
    margin-bottom: 4px;
  }
  .hero-card input,
  .hero-card select,
  .hero-card textarea {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid var(--line);
    border-radius: 9px;
    font-size: 0.92rem;
    font-family: inherit;
  }
  .hero-card .btn {
    width: 100%;
    margin-top: 6px;
  }
  .hero-card .tiny {
    font-size: 0.72rem;
    color: var(--muted);
    margin: 10px 0 0;
  }
  @media (max-width: 860px) {
    .hero .wrap {
      grid-template-columns: 1fr;
    }
  }

  /* ROLE BANNER */
  .role-banner {
    background: #eef5fb;
    border-bottom: 1px solid #c7ddf0;
    color: #234;
    font-size: 0.9rem;
    text-align: center;
    padding: 12px 22px;
  }

  /* TRUST BAR */
  .trust {
    background: var(--navy);
    color: #fff;
  }
  .trust .wrap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 30px 22px;
    text-align: center;
  }
  .trust .num {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
  }
  .trust .lbl {
    font-size: 0.84rem;
    color: #b9cbe0;
  }
  @media (max-width: 760px) {
    .trust .wrap {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  /* TEAM */
  .doc {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .doc .photo {
    aspect-ratio: 1/1;
    background: linear-gradient(135deg, #dceaf7, #cfeae8);
    display: grid;
    place-items: center;
    color: #4c6f86;
    font-weight: 600;
  }
  .doc .body {
    padding: 18px 20px;
  }
  .doc h3 {
