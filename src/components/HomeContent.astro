<script is:inline>
  // Non-critical UI (carousel autoplay + testimonial filters). Deferred off the
  // critical path with requestIdleCallback so it doesn't add to Total Blocking Time.
  function initHomeUI() {
    // Carousel
    (function () {
      var track = document.getElementById('kc-track');
      if (!track) return;
      var slides = track.children,
        total = slides.length,
        i = 0,
        timer;
      var dotsWrap = document.getElementById('kc-dots');
      for (var d = 0; d < total; d++) {
        var b = document.createElement('button');
        b.setAttribute('aria-label', 'Slide ' + (d + 1));
        (function (idx) {
          b.addEventListener('click', function () {
            go(idx);
            reset();
          });
        })(d);
        dotsWrap.appendChild(b);
      }
      var dots = dotsWrap.children;
      function go(n) {
        i = (n + total) % total;
        track.style.transform = 'translateX(-' + i * 100 + '%)';
        for (var k = 0; k < dots.length; k++) dots[k].classList.toggle('active', k === i);
      }
      function next() {
        go(i + 1);
      }
      function prev() {
        go(i - 1);
      }
      function start() {
        timer = setInterval(next, 9000);
      }
      function reset() {
        clearInterval(timer);
        start();
      }
      document.getElementById('kc-next').addEventListener('click', function () {
        next();
        reset();
      });
      document.getElementById('kc-prev').addEventListener('click', function () {
        prev();
        reset();
      });
      var kc = document.getElementById('kc');
      kc.addEventListener('mouseenter', function () {
        clearInterval(timer);
      });
      kc.addEventListener('mouseleave', start);
      go(0);
      start();
    })();
  }

  if ('requestIdleCallback' in window) requestIdleCallback(initHomeUI, { timeout: 2000 });
  else setTimeout(initHomeUI, 200);
</script>
