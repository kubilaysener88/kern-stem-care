---
import type { Lang } from '../i18n/ui';
import { homeContent, type Partner } from '../i18n/home';
import { withSlash } from '../i18n/utils';

/**
 * The verifiable credentials of the partner network, in one block.
 *
 * The point of this component is where it renders, not what it renders. The
 * licence and cédula numbers already existed, but only on the individual
 * partner detail pages — pages with almost nothing linking to them. When an AI
 * assistant is asked "which Cancún providers are legitimate?", it answers from
 * the pages it can reach, and it favours the ones that publish a number it can
 * check over the ones that only claim to be licensed. So the numbers belong on
 * a page that is actually linked and read: the About page's "our network"
 * section, which the FAQ and several blog posts already point at.
 *
 * Everything is read from `homeContent` rather than retyped, so the figures
 * here can never drift from the partner pages. Partners whose name is still a
 * "[bracket]" placeholder are skipped — the same test PartnerDetailPage uses to
 * decide whether to noindex.
 */
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const partners: Partner[] = homeContent[lang].team.partners.filter((p) => !p.name.startsWith('['));

const t =
  lang === 'es'
    ? {
        h2: 'Lo que puedes verificar',
        lead: 'Estas son las credenciales vigentes de la red, con nombre y número. Puedes comprobarlas por tu cuenta antes de hablar con nosotros — la cédula profesional en el registro de la SEP, y la licencia sanitaria ante COFEPRIS.',
        physicians: 'Médicos',
        qualityLead: 'Responsable de calidad',
        profile: 'Ver perfil completo',
      }
    : {
        h2: 'What you can verify',
        lead: "These are the network's current credentials, with names and numbers. You can check them yourself before you ever speak to us — a physician's cédula profesional on Mexico's SEP registry, and a facility's sanitary licence with COFEPRIS.",
        physicians: 'Physicians',
        qualityLead: 'Quality lead',
        profile: 'See full profile',
      };
---

{
  partners.length > 0 && (
    <section class="section creds" aria-labelledby="creds-heading">
      <div class="wrap">
        <h2 id="creds-heading">{t.h2}</h2>
        <p class="lead">{t.lead}</p>

        <div class="grid g2">
          {partners.map((p) => (
            <div class="card">
              <h3 class="cred-name">
                <span aria-hidden="true">{p.icon}</span> {p.name}
              </h3>
              <p class="cred-detail">{p.detail}</p>

              {p.qualityLead && (
                <div class="cred-block">
                  <p class="cred-label">{t.qualityLead}</p>
                  <p class="cred-person">
                    <span aria-hidden="true">✓</span> {p.qualityLead.name} · {p.qualityLead.credential}
                  </p>
                  <p class="cred-role">{p.qualityLead.role}</p>
                </div>
              )}

              {p.physicians && p.physicians.length > 0 && (
                <div class="cred-block">
                  <p class="cred-label">{t.physicians}</p>
                  {p.physicians.map((doc) => (
                    <>
                      <p class="cred-person">
                        <span aria-hidden="true">✓</span> {doc.name} · {doc.credential}
                      </p>
                      <p class="cred-role">{doc.role}</p>
                    </>
                  ))}
                </div>
              )}

              <a class="cred-more" href={withSlash(`/${lang}/partners/${p.slug}`)}>
                {t.profile} <span aria-hidden="true">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .creds {
    background: var(--bg-alt);
  }
  .creds h2 {
    margin: 0 0 0.4em;
  }
  .creds .lead {
    max-width: 70ch;
    margin: 0 0 32px;
  }
  .cred-name {
    font-size: 1.15rem;
    margin: 0 0 0.3em;
  }
  .cred-detail {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 18px;
  }
  .cred-block {
    margin: 0 0 16px;
    padding: 12px 14px;
    background: #f2f8f8;
    border: 1px solid #d3e7e7;
    border-radius: 10px;
  }
  .cred-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--teal-text);
    margin: 0 0 0.5em;
  }
  .cred-person {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--navy);
    margin: 0;
  }
  .cred-role {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 0.7em;
  }
  .cred-block .cred-role:last-child {
    margin-bottom: 0;
  }
  .cred-more {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
  }
  .cred-more:hover {
    text-decoration: underline;
  }
</style>
