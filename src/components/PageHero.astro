---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string; // inline HTML allowed (may contain placeholder spans)
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead" set:html={lead} />}
  </div>
</section>
