---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string; // inline HTML allowed (may contain placeholder spans)
  /** Path under /public. When set, shown as the banner's background photo
      (decorative — the gradient overlay keeps text at AA contrast). */
  image?: string;
  /** CSS background-position for `image` (e.g. "center 20%" to favor the top
      of a portrait). Defaults to "center". */
  imagePosition?: string;
  /** Alternative to `image`: a row of photos filling the banner side by side
      (a collage), with the same gradient overlay on top. Ignored if `image` is set. */
  images?: string[];
}
const { eyebrow, title, lead, image, imagePosition, images } = Astro.props;
const hasCollage = !image && !!images && images.length > 0;
---

<section
  class:list={['page-hero', { 'has-photo': !!image || hasCollage }]}
  style={image ? `background-image:url(${image});background-position:${imagePosition || 'center'}` : undefined}
>
  {hasCollage && (
    <div class="hero-collage" aria-hidden="true">
      {images!.map((src) => <img src={src} alt="" loading="eager" decoding="async" />)}
    </div>
  )}
  <div class="wrap">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead" set:html={lead} />}
  </div>
</section>
